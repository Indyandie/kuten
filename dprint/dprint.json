{
  "includes": [
    "**/*.{js,jsx,ts,tsx,json,md,mdx,css,yaml,yml,html}"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/target",
    "**/.git"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.101.0",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:dprint-plugin-malva@0.16.1",
    "npm:dprint-plugin-markup@0.28.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/nix@0.2.0",
    "npm:@dprint/shuck@0.2.7",
    "npm:@dprint/toml@0.10.0",
    "npm:@dprint/sql@0.5.0",
    "npm:@dprint/kdl@0.5.0",
    "npm:@dprint/clang-format@0.3.2"
  ],
  "typescript": {
    "quoteStyle": "alwaysSingle",
    "lineWidth": 999999,
    "indentWidth": 2,
    "useTabs": false,
    "semicolons": "asi"
  },
  "json": {
    "lineWidth": 999999,
    "indentWidth": 2,
    "useTabs": false
  },
  "markdown": {
    "lineWidth": 999999,
    "textWrap": "maintain",
    "newLineKind": "lf",
    "emphasisKind": "underscores",
    "strongKind": "asterisks",
    "heading.kind": "atx",
    "list.unorderedMarker": "dashes",
    "ignoreDirective": "formatter-ignore",
    "ignoreFileDirective": "formatter-ignore-file",
    "ignoreStartDirective": "formatter-ignore-start",
    "ignoreEndDirective": "formatter-ignore-end",
    "html.skipFormat": false,
    "html.preferSingleLine": false,
    "html.indentWidth": 3,
    "html.useTabs": true
  },
  "pretty_yaml": {},
  "clangFormat": {
    "BasedOnStyle": "Mozilla",
    "IndentWidth": 3,
    "ColumnLimit": 999999,
    "PointerAlignment": "Left",
    "AllowShortFunctionsOnASingleLine": "Empty",
    "BreakBeforeBraces": "Attach",

    "TabWidth": 3,
    "ContinuationIndentWidth": 3,
    "UseTab": "Always",

    "AlignAfterOpenBracket": "AlwaysBreak",
    "AlignOperands": "DontAlign",
    "AlignConsecutiveAssignments": "None",
    "AlignConsecutiveDeclarations": "None",
    "AlignEscapedNewlines": "DontAlign",
    "BinPackArguments": false,
    "BinPackParameters": false,

    "MaxEmptyLinesToKeep": 1,
    "AllowAllArgumentsOnNextLine": true,
    "AllowShortBlocksOnASingleLine": "Never",
    "AllowShortFunctionsOnASingleLine": "None",
    "AllowShortIfStatementsOnASingleLine": "Never",
    "AllowShortLoopsOnASingleLine": false,
    "BreakBeforeBraces": "Attach",
    "ColumnLimit": 0,
    "IndentCaseLabels": true,
    "SpaceAfterLogicalNot": false,
    "SpaceBeforeAssignmentOperators": true,
    "SpaceBeforeParens": "ControlStatements",
    "SpacesInParentheses": false,
    "SortIncludes": {
      "Enabled": false
    },
  },
  "markup_fmt": {
    "print_width": 999999,
    "indent_width": 3
  }
}
